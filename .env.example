# Copie para ajustar o backend no Docker Compose (use: env_file ou sobrescreva em docker-compose.yml)
# Não commite segredos.

# --- Backend (Nest) — já definidos no docker-compose.yml; use isto como referência local ---
# DATABASE_URL=file:/app/data/dev.db
# BASE_URL=http://localhost:3000
# N8N_WEBHOOK_CREATE_CHATBOT=https://seu-n8n/webhook/...
# N8N_WEBHOOK_DOCUMENT_UPSERT=https://seu-n8n/webhook/...
# N8N_WEBHOOK_STATUS=https://seu-n8n/webhook/...

# --- Front (Vite) — desenvolvimento local (npm run dev) ---
# VITE_API_BASE=/api
# VITE_ENABLE_BASE44_AUTH=false

# --- Vercel (build do front) — URL pública da API Nest ---
# VITE_API_BASE=https://api.seudominio.com
